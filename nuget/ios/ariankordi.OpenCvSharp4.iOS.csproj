<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <NoBuild>true</NoBuild>
    <IncludeBuildOutput>false</IncludeBuildOutput>

    <!-- NuGet Package Metadata -->
    <PackageId>ariankordi.OpenCvSharp4.iOS</PackageId>
    <Title>OpenCvSharp for iOS (managed + native, device + simulator, arm64)</Title>
    <Authors>shimat</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/shimat/opencvsharp</PackageProjectUrl>
    <PackageIcon>opencvsharp.png</PackageIcon>
    <Description>
      OpenCvSharp4 for .NET MAUI iOS. Bundles the managed assembly (compiled with
      __Internal P/Invoke for static linking) and a static xcframework covering
      ios-arm64 (physical device) and iossimulator-arm64 (Simulator), built with
      core, imgproc, and imgcodecs modules only. Reference this package instead of
      OpenCvSharp4 + a separate runtime package in your iOS project.
    </Description>
    <PackageTags>Image Processing OpenCV Wrapper FFI opencvsharp ios maui</PackageTags>
    <Copyright>Copyright 2008-2026</Copyright>
    <PackageReleaseNotes></PackageReleaseNotes>
    <RepositoryUrl>https://github.com/shimat/opencvsharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageReadmeFile>README.runtime.md</PackageReadmeFile>
  </PropertyGroup>

  <!--
    Prerequisites before dotnet pack:
      1. dotnet build src/OpenCvSharp/OpenCvSharp.csproj -f net9.0-ios -c Release
      2. src/tools/build-opencvsharp-ios.sh  (produces ios-build/OpenCvSharpExtern.xcframework)
  -->
  <ItemGroup>
    <!-- Managed assembly compiled with DllExtern = "__Internal" for iOS static linking -->
    <None Include="..\..\src\OpenCvSharp\bin\Release\net9.0-ios\OpenCvSharp.dll"
          Pack="true"
          PackagePath="lib\net9.0-ios\OpenCvSharp.dll" />
    <None Include="..\..\src\OpenCvSharp\bin\Release\net9.0-ios\OpenCvSharp.xml"
          Pack="true"
          PackagePath="lib\net9.0-ios\OpenCvSharp.xml" />

    <!-- xcframework: both ios-arm64 (device) and ios-arm64-simulator slices -->
    <None Include="..\..\ios-build\OpenCvSharpExtern.xcframework\**"
          Pack="true"
          PackagePath="OpenCvSharpExtern.xcframework\%(RecursiveDir)%(Filename)%(Extension)" />

    <!--
      MSBuild targets that inject <NativeReference> into the consuming MAUI project.
      The condition inside gates on -ios TFMs only.
    -->
    <None Include="ariankordi.OpenCvSharp4.iOS.targets"
          Pack="true"
          PackagePath="build\net9.0\ariankordi.OpenCvSharp4.iOS.targets" />
    <None Include="ariankordi.OpenCvSharp4.iOS.targets"
          Pack="true"
          PackagePath="buildTransitive\net9.0\ariankordi.OpenCvSharp4.iOS.targets" />

    <None Include="..\icon\opencvsharp.png" Pack="true" PackagePath="" />
    <None Include="..\README.runtime.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
