<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Injects the OpenCvSharpExtern static xcframework so the MAUI linker includes it.
    ForceLoad=True keeps all P/Invoke symbols live; without it the linker strips them
    and DllImport("OpenCvSharpExtern") throws DllNotFoundException at runtime.
  -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net')) And $(TargetFramework.Contains('-ios'))">
    <NativeReference Include="$(MSBuildThisFileDirectory)..\..\OpenCvSharpExtern.xcframework">
      <Kind>Static</Kind>
      <ForceLoad>True</ForceLoad>
      <SmartLink>False</SmartLink>
    </NativeReference>
  </ItemGroup>
</Project>
