<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BeginnersTasks.MainPage"
             Title="OpenCvSharp iOS Test">

    <VerticalStackLayout Padding="20" Spacing="16" VerticalOptions="Center">

        <Label Text="OpenCvSharp iOS Smoke Test"
               FontSize="22"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <Button x:Name="RunButton"
                Text="Run Tests"
                Clicked="OnRunClicked"
                HorizontalOptions="Fill" />

        <ScrollView>
            <Label x:Name="ResultLabel"
                   Text="Press 'Run Tests' to start."
                   FontSize="14"
                   LineBreakMode="WordWrap" />
        </ScrollView>

    </VerticalStackLayout>

</ContentPage>